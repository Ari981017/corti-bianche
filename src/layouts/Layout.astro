---
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/cormorant-garamond/latin-700.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** true per le pagine che non vanno su Google (es. /admin) */
  noindex?: boolean;
  /** true per nascondere intestazione e piè di pagina del sito */
  bare?: boolean;
  /** true se la pagina inizia con la scena video a tutto schermo */
  heroOverlay?: boolean;
}

const {
  title,
  description = 'Le Corti Bianche, caseificio artigianale. Formaggi fatti a mano, come una volta.',
  noindex = false,
  bare = false,
  heroOverlay = false,
} = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1F2420" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="it_IT" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    {!bare && <Header overlay={heroOverlay} />}
    <main>
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
