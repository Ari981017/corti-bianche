---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Pannello – Le Corti Bianche" noindex bare>
  <!-- Accesso -->
  <section class="login" data-view="login" hidden>
    <form class="card login-card" data-login>
      <h1>Pannello <span class="it">Le Corti Bianche</span></h1>
      <p class="muted">Accedi per gestire prodotti e prezzi.</p>
      <label>Email<input type="email" name="email" autocomplete="username" required /></label>
      <label>Password<input type="password" name="password" autocomplete="current-password" required /></label>
      <p class="error" data-login-error role="alert"></p>
      <button class="btn" type="submit">Accedi</button>
    </form>
  </section>

  <!-- Pannello -->
  <div class="app" data-view="app" hidden>
    <header class="topbar">
      <div class="container topbar-inner">
        <span class="brand">Le Corti Bianche <span class="tag">Pannello</span></span>
        <div class="who">
          <span class="muted" data-user></span>
          <a href="/" target="_blank" rel="noopener">Vedi il sito</a>
          <button type="button" class="btn btn-small btn-outline" data-logout>Esci</button>
        </div>
      </div>
    </header>

    <div class="container">
      <div class="tabs" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-tab="products">Prodotti</button>
        <button type="button" role="tab" aria-selected="false" data-tab="categories">Categorie</button>
      </div>

      <!-- Prodotti -->
      <section data-panel="products">
        <div class="panel-head">
          <h2>Prodotti <span class="muted count" data-pcount></span></h2>
          <button type="button" class="btn" data-new>+ Nuovo prodotto</button>
        </div>
        <p class="muted hint">I prodotti con "Disponibile" spento restano salvati ma non si vedono sul sito.</p>
        <ul class="plist" data-plist></ul>
      </section>

      <!-- Categorie -->
      <section data-panel="categories" hidden>
        <div class="panel-head">
          <h2>Categorie</h2>
        </div>
        <form class="card cat-add" data-cat-add>
          <label>Nuova categoria<input name="name" placeholder="Es. Freschi" required /></label>
          <button class="btn" type="submit">Aggiungi</button>
        </form>
        <p class="muted hint">L'ordine decide come appaiono le categorie sul sito (numero più basso = prima).</p>
        <ul class="clist" data-clist></ul>
      </section>
    </div>
  </div>

  <!-- Scheda prodotto -->
  <dialog class="pdialog" data-dialog>
    <form method="dialog" class="pform" data-pform novalidate>
      <div class="pform-head">
        <h2 data-ftitle>Nuovo prodotto</h2>
        <button type="button" class="icon-btn" aria-label="Chiudi" data-cancel>
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
      </div>

      <div class="photo-field">
        <div class="photo-preview ph" data-preview><span class="ph-label">Nessuna foto</span></div>
        <div class="photo-actions">
          <label class="btn btn-outline file-btn">
            Scegli foto
            <input type="file" accept="image/*" data-file class="sr-only" />
          </label>
          <button type="button" class="btn btn-outline" data-remove-photo hidden>Togli foto</button>
          <p class="muted small">Va bene anche una foto fatta col telefono: la rimpiccioliamo noi.</p>
        </div>
      </div>

      <label>Nome *<input name="name" required maxlength="120" /></label>
      <label>Indirizzo della pagina (slug)<input name="slug" pattern="[a-z0-9-]+" maxlength="120" /></label>
      <label>Categoria<select name="category_id" data-catselect></select></label>
      <label>Descrizione<textarea name="description" rows="3" maxlength="600"></textarea></label>

      <div class="row">
        <label>Prezzo (€) *<input name="price" type="number" inputmode="decimal" min="0" step="0.01" required /></label>
        <label>Al / alla
          <select name="unit">
            <option value="kg">kg</option>
            <option value="etto">etto</option>
            <option value="pezzo">pezzo</option>
            <option value="confezione">confezione</option>
          </select>
        </label>
      </div>
      <p class="muted small" data-perkg></p>

      <div class="row">
        <label>Ordine<input name="position" type="number" step="1" /></label>
        <label class="switch-label">
          <input type="checkbox" name="is_available" class="switch" />
          Disponibile
        </label>
      </div>

      <p class="error" data-ferror role="alert"></p>
      <div class="pform-actions">
        <button type="button" class="btn btn-outline" data-cancel>Annulla</button>
        <button type="submit" class="btn" data-save>Salva</button>
      </div>
    </form>
  </dialog>

  <div class="toast" role="status" aria-live="polite" data-toast></div>
</Layout>

<script>
  import { initAdmin } from '../../scripts/admin';
  initAdmin();
</script>

<style>
  :global(body) { background: var(--calce); }
  .muted { color: var(--testo-3); }
  .small { font-size: 14px; }
  .error { color: #B3261E; font-size: 15px; min-height: 1em; }
  .card { background: var(--bianco); border-radius: 18px; box-shadow: inset 0 0 0 1px var(--bordo); padding: 24px; }

  label { display: flex; flex-direction: column; gap: 6px; font-size: 15px; font-weight: 600; }
  input:not([type='checkbox']):not([type='file']), select, textarea {
    font: 400 17px/1.4 var(--sans);
    padding: 12px 14px;
    min-height: 48px;
    border-radius: 12px;
    border: 1px solid #CFC7B4;
    background: var(--bianco);
    color: var(--testo);
    width: 100%;
  }
  input:focus, select:focus, textarea:focus { outline: 3px solid var(--paglia); outline-offset: 1px; border-color: var(--verde); }

  .btn-small { min-height: 40px; padding: 8px 16px; font-size: 15px; }
  .btn-outline { background: transparent; color: var(--verde); box-shadow: inset 0 0 0 1.5px var(--verde); }
  .btn-outline:hover { background: var(--calce-scuro); color: var(--verde); }
  .btn-danger { background: transparent; color: #B3261E; box-shadow: inset 0 0 0 1.5px #E0B7B3; }
  .btn-danger:hover { background: #FBEDEB; color: #B3261E; }
  .btn[disabled] { opacity: .6; cursor: progress; }

  /* accesso */
  .login { min-height: 100vh; min-height: 100svh; display: grid; place-items: center; padding: 24px; }
  .login-card { width: min(420px, 100%); display: flex; flex-direction: column; gap: 16px; padding: 32px; }
  .login-card h1 { font-size: 40px; }

  /* barra */
  .topbar { background: var(--inchiostro); color: #F4EFE3; }
  .topbar-inner { min-height: 64px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding-top: 10px; padding-bottom: 10px; }
  .brand { font-family: var(--serif); font-size: 23px; font-weight: 700; }
  .tag { font-family: var(--sans); font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--paglia); margin-left: 8px; }
  .who { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; font-size: 15px; }
  .who a { color: #F4EFE3; }
  .who .btn-outline { color: #F4EFE3; box-shadow: inset 0 0 0 1.5px rgba(244,239,227,.5); }
  .who .btn-outline:hover { background: rgba(255,255,255,.1); }
  .who .muted { color: #B8AF9C; }

  .tabs { display: flex; gap: 8px; margin: 32px 0 24px; }
  .tabs button { font: 600 16px var(--sans); min-height: 44px; padding: 8px 20px; border-radius: 999px; border: 0; background: var(--calce-scuro); color: var(--verde); cursor: pointer; }
  .tabs button[aria-selected='true'] { background: var(--verde); color: var(--calce); }

  .panel-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .panel-head h2 { font-size: 40px; }
  .count { font-family: var(--sans); font-size: 18px; font-weight: 400; }
  .hint { margin: 12px 0 20px; font-size: 15px; }

  /* lista prodotti */
  .plist, .clist { list-style: none; margin: 0 0 80px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .plist :global(li) { background: var(--bianco); border-radius: 16px; box-shadow: inset 0 0 0 1px var(--bordo); padding: 12px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
  .plist :global(li.off) { opacity: .65; }
  .plist :global(.thumb) { width: 72px; height: 72px; border-radius: 12px; object-fit: cover; flex: 0 0 auto; background: #E6DBC2; }
  .plist :global(.pinfo) { flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  .plist :global(.pname) { font-family: var(--serif); font-size: 24px; font-weight: 600; line-height: 1.1; }
  .plist :global(.pmeta) { font-size: 15px; color: var(--testo-3); }
  .plist :global(.pactions) { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .plist :global(.empty), .clist :global(.empty) { background: transparent; box-shadow: none; color: var(--testo-3); }

  /* interruttore */
  .switch-label, .plist :global(.switch-label) { flex-direction: row; align-items: center; gap: 10px; font-weight: 600; cursor: pointer; }
  .switch, .plist :global(.switch) { appearance: none; width: 48px; height: 28px; border-radius: 999px; background: #CFC7B4; position: relative; cursor: pointer; transition: background .2s; flex: 0 0 auto; margin: 0; }
  .switch::after, .plist :global(.switch::after) { content: ''; position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: #fff; transition: transform .2s; }
  .switch:checked, .plist :global(.switch:checked) { background: var(--verde); }
  .switch:checked::after, .plist :global(.switch:checked::after) { transform: translateX(20px); }

  /* categorie */
  .cat-add { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; margin-top: 16px; }
  .cat-add label { flex: 1 1 240px; }
  .clist :global(li) { background: var(--bianco); border-radius: 16px; box-shadow: inset 0 0 0 1px var(--bordo); padding: 12px; display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; }
  .clist :global(.cname) { flex: 1 1 220px; }
  .clist :global(.cpos) { flex: 0 0 110px; }

  /* scheda prodotto */
  .pdialog { width: min(640px, calc(100% - 24px)); max-height: calc(100% - 24px); border: 0; border-radius: 22px; padding: 0; background: var(--calce); color: var(--testo); }
  .pdialog::backdrop { background: rgba(20, 22, 20, .55); }
  .pform { display: flex; flex-direction: column; gap: 16px; padding: 24px; }
  .pform-head { display: flex; align-items: center; justify-content: space-between; }
  .pform-head h2 { font-size: 36px; }
  .icon-btn { width: 44px; height: 44px; border-radius: 999px; border: 0; background: var(--calce-scuro); color: var(--testo); display: grid; place-items: center; cursor: pointer; }
  .row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; align-items: end; }
  .row .switch-label { min-height: 48px; }
  .photo-field { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
  .photo-preview { width: 140px; height: 140px; border-radius: 16px; background: #E6DBC2; flex: 0 0 auto; padding: 10px; background-size: cover; background-position: center; }
  .photo-actions { flex: 1 1 200px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .file-btn { flex-direction: row; cursor: pointer; }
  .pform-actions { display: flex; justify-content: flex-end; gap: 12px; position: sticky; bottom: 0; background: var(--calce); padding-top: 8px; }

  .toast { position: fixed; left: 50%; bottom: 24px; transform: translate(-50%, 140%); background: var(--inchiostro); color: #F4EFE3; padding: 14px 22px; border-radius: 999px; font-weight: 600; transition: transform .3s; z-index: 200; max-width: calc(100% - 32px); }
  .toast.show { transform: translate(-50%, 0); }
  .toast.err { background: #B3261E; }

  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; }
  }
</style>
