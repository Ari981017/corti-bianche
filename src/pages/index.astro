---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Le Corti Bianche – Caseificio">
  <section class="hero">
    <!-- Qui andrà l'animazione latte → formaggio -->
    <h1>Le Corti Bianche</h1>
    <p class="tagline">Formaggi freschi dal nostro caseificio</p>
    <a href="/products" class="btn">Scopri i prodotti</a>
  </section>

  <section class="intro">
    <h2>La nostra storia</h2>
    <p>
      Testo provvisorio: due righe su chi siete e da dove nasce il caseificio.
    </p>
    <a href="/storia">Leggi di più →</a>
  </section>

  <section class="highlight">
    <h2>I nostri prodotti</h2>
    <p>Latte locale, lavorazione artigianale, ogni giorno.</p>
    <a href="/products" class="btn">Vai al catalogo</a>
  </section>

  <section class="visit">
    <h2>Vieni a trovarci</h2>
    <p>Indirizzo · Orari · Telefono</p>
    <a href="/contatti">Contatti →</a>
  </section>
</Layout>

<style>
  section {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 1.5rem;
    gap: 1rem;
  }
  .hero { min-height: 100vh; }
  h1 { font-size: clamp(3rem, 8vw, 6rem); margin: 0; }
  h2 { font-size: clamp(2rem, 5vw, 3.5rem); margin: 0; }
  .tagline { font-size: 1.25rem; opacity: 0.7; }
  .btn {
    padding: 0.8rem 1.6rem;
    border-radius: 999px;
    background: #1d1d1f;
    color: white;
    text-decoration: none;
  }
</style>