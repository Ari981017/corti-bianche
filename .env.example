# Copia questo file in .env e inserisci i valori del tuo progetto Supabase
# (Project Settings → API). Su Netlify vanno in Site configuration → Environment variables.
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Chiave pubblica "anon" / "publishable". MAI la chiave service_role.
PUBLIC_SUPABASE_KEY=
